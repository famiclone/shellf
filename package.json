{
  "name": "shellf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.22",
  "scripts": {
    "dev": "bun run setup:emulator && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "bun run --cwd apps/backend db:generate",
    "db:migrate": "bun run --cwd apps/backend db:migrate",
    "db:seed": "bun run --cwd apps/backend db:seed",
    "setup:emulator": "bash scripts/setup-emulator.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
